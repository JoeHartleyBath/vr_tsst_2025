  title = {Workplace {{Stress}} and {{Productivity}}: {{A Cross-Sectional Study}}},
  shorttitle = {Workplace {{Stress}} and {{Productivity}}},
  author = {Bui, Tina and Zackula, Rosey and Dugan, Katelyn and Ablah, Elizabeth},
