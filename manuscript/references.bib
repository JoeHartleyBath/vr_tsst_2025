@article{albulescuGiveMeBreak2022,
  title = {"{{Give}} Me a Break!" {{A}} Systematic Review and Meta-Analysis on the Efficacy of Micro-Breaks for Increasing Well-Being and Performance},
  author = {Albulescu, Patricia and Macsinga, Irina and Rusu, Andrei and Sulea, Coralia and Bodnaru, Alexandra and Tulbure, Bogdan Tudor},
  year = 2022,
