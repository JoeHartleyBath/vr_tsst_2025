@article{reyBreaksPresenceVirtual2011,
  title = {Breaks in {{Presence}} in {{Virtual Environments}}: {{An Analysis}} of {{Blood Flow Velocity Responses}}},
  shorttitle = {Breaks in {{Presence}} in {{Virtual Environments}}},
  author = {Rey, Beatriz and Parkhutik, Vera and Alca{\~n}iz, Mariano},
  year = 2011,
