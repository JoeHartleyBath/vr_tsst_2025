  booktitle = {2021 {{International Conference}} on E-{{Health}} and {{Bioengineering}} ({{EHB}})},
  author = {Motogna, Victor and {Lupu-Florian}, Georgina and Lupu, Eugen},
  year = 2021,
  month = nov,
  pages = {1--4},
  issn = {2575-5145},
  doi = {10.1109/EHB52898.2021.9657654},
  urldate = {2024-09-20},
  abstract = {Predicting and recognizing emotions is becoming an important preoccupation for the medical field, but also in areas such as organizational wellbeing, psychotherapy or neuromarketing. Biological signals are powerful markers for emotions and stress, as shown by previous research and the rising field of affective computing. This paper presents the design and implementation of a strategy to classify emotions and emotional dimensions by using heart rate variability (HRV) and electrodermal activity (EDA) as physiological indicators, after researching multiple potential markers for emotional states. A new dataset was created during the presented research and machine learning techniques were used to assess whether the two chosen bio-signals are strong indicators for human emotions. Results indicate that the design of the strategy is a successful one, with obtained accuracies of up to 86\% being aligned with results from other papers, while the sensors used are highly affordable and accessible.},
  keywords = {Affective computing,bio-signals,biosensors,EDA,Electric potential,emotion detection,Emotion recognition,Heart rate variability,HRV,Machine learning,Physiology,Sensors},
  file = {C\:\\Users\\Joe\\Zotero\\storage\\RNC86WF5\\Motogna et al. - 2021 - Strategy For Affective Computing Based on HRV and .pdf;C\:\\Users\\Joe\\Zotero\\storage\\AHFQT3ZY\\9657654.html}
}

@article{muhlEEGbasedWorkloadEstimation2014,
  title = {{{EEG-based}} Workload Estimation across Affective Contexts},
  author = {M{\"u}hl, Christian and Jeunet, Camille and Lotte, Fabien},
  year = 2014,
  month = jun,
  journal = {Frontiers in Neuroscience},
  volume = {8},
  publisher = {Frontiers},
  issn = {1662-453X},
  doi = {10.3389/fnins.2014.00114},
  urldate = {2025-10-29},
  abstract = {Workload estimation from electroencephalographic signals (EEG) offers a highly sensitive tool to adapt the human-computer interaction to the user state. To create systems that reliably work in the complexity of the real world, a robustness against contextual changes (e.g., mood), has to be achieved. To study the resilience of state-of-the-art EEG-based workload classification against stress we devise a novel experimental protocol, in which we manipulated the affective context (stressful/non-stressful) while the participant solved a task with 2 workload levels. We recorded self-ratings, behavior, and physiology from 24 participants to validate the protocol. We test the capability of different, subject-specific workload classifiers using either frequency-domain, time-domain, or both feature varieties to generalize across contexts. We show that the classifiers are able to transfer between affective contexts, though performance suffers independent of the used feature domain. However, cross-context training is a simple and powerful remedy allowing the extraction of features in all studied feature varieties that are more resilient to task-unrelated variations in signal characteristics. Especially for frequency-domain features, across-context training is leading to a performance comparable to within-context training and testing. We discuss the significance of the result for neurophysiology-based workload detection in particular and for the construction of reliable passive brain-computer interfaces in general.},
  langid = {english},
  keywords = {Brain-computer interface,Classification,Electroencephalography,Passive Brain Computer Interface,stress,Workload},
  file = {C:\Users\Joe\Zotero\storage\L3382L46\Mühl et al. - 2014 - EEG-based workload estimation across affective contexts.pdf}
}

