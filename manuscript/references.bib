@article{aminigougehHeadMountedDisplayBasedVirtual2022,
  title = {Head-{{Mounted Display-Based Virtual Reality}} and {{Physiological Computing}} for {{Stroke Rehabilitation}}: {{A Systematic Review}}},
  shorttitle = {Head-{{Mounted Display-Based Virtual Reality}} and {{Physiological Computing}} for {{Stroke Rehabilitation}}},
