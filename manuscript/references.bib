@misc{caiNeuralCorrelatesIllusionary2023,
  title = {Neural Correlates of an Illusionary Sense of Agency Caused by Virtual Reality},
  author = {Cai, Yiyang and Yang, Huichao and Xiong, Ziyi and K{\"u}hn, Simone and Bi, Yanchao and Wei, Kunlin},
  year = 2023,
  month = mar,
  primaryclass = {New Results},
  pages = {2022.09.21.508963},
  publisher = {bioRxiv},
  doi = {10.1101/2022.09.21.508963},
  urldate = {2023-10-09},
  abstract = {As a part of self-consciousness, sense of agency (SoA) refers to our sensation that we initiate actions that lead to ensuing perceptual consequences. The prospective theory of agency posits that motor prediction and its comparison with the subsequent action outcome underlies SoA. In contrast, the reconstructive theory posits that retrospective causal processing of action outcome leads to SoA without the necessity of action planning. Previous neuroimaging studies provide direct neural support for the prospective theory by showing the agency network includes brain regions for action planning and intentionality, but the equivalent neural evidence for the reconstructive theory is lacking despite behavioral evidence. Here we utilized virtual reality (VR) technology to induce an illusionary SoA in the absence of voluntary action and examined it by functional magnetic resonance imaging (fMRI). Participants' experience of controlling an avatar hand elicited a persistent increase in temporal binding, a behavioral marker of SoA when they merely passively observed the avatar hand's movement in the scanner. fMRI results showed that the increased temporal binding was associated with a cluster centered in the right angular gyrus, extending to the right inferior parietal lobule and the right precuneus. These associative areas engage in causal processing and inferential sensemaking in various tasks beyond agency. In contrast, other traditional agency-related brain areas, especially those governing action intentionality and motor planning, were not implicated. Our findings not only provide direct neural support for the reconstructive theory of agency but also suggest that the experience of controlling an avatar boosts the inferential processing of ``virtual'' actions that reside in posterior parietal regions, namely the angular gyrus.},
  archiveprefix = {bioRxiv},
  chapter = {New Results},
  copyright = {\copyright{} 2023, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution 4.0 International), CC BY 4.0, as described at http://creativecommons.org/licenses/by/4.0/},
  langid = {english},
  file = {C:\Users\Joe\Zotero\storage\UDRIT29V\Cai et al. - 2023 - Neural correlates of an illusionary sense of agenc.pdf}
}

