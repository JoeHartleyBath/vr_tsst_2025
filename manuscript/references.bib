@article{kangBrainNetworksResponsible2015,
  title = {Brain {{Networks Responsible}} for {{Sense}} of {{Agency}}: {{An EEG Study}}},
  shorttitle = {Brain {{Networks Responsible}} for {{Sense}} of {{Agency}}},
  author = {Kang, Suk Yun and Im, Chang-Hwan and Shim, Miseon and Nahab, Fatta B. and Park, Jihye and Kim, Do-Won and Kakareka, John and Miletta, Nathanial and Hallett, Mark},
  year = 2015,
  month = aug,
  journal = {PLOS ONE},
  volume = {10},
  number = {8},
  pages = {e0135261},
  publisher = {Public Library of Science},
  issn = {1932-6203},
  doi = {10.1371/journal.pone.0135261},
  urldate = {2023-10-10},
  abstract = {Background Self-agency (SA) is a person's feeling that his action was generated by himself. The neural substrates of SA have been investigated in many neuroimaging studies, but the functional connectivity of identified regions has rarely been investigated. The goal of this study is to investigate the neural network related to SA. Methods SA of hand movements was modulated with virtual reality. We examined the cortical network relating to SA modulation with electroencephalography (EEG) power spectrum and phase coherence of alpha, beta, and gamma frequency bands in 16 right-handed, healthy volunteers. Results In the alpha band, significant relative power changes and phase coherence of alpha band were associated with SA modulation. The relative power decrease over the central, bilateral parietal, and right temporal regions (C4, Pz, P3, P4, T6) became larger as participants more effectively controlled the virtual hand movements. The phase coherence of the alpha band within frontal areas (F7-FP2, F7-Fz) was directly related to changes in SA. The functional connectivity was lower as the participants felt that they could control their virtual hand. In the other frequency bands, significant phase coherences were observed in the frontal (or central) to parietal, temporal, and occipital regions during SA modulation (Fz-O1, F3-O1, Cz-O1, C3-T4L in beta band; FP1-T6, FP1-O2, F7-T4L, F8-Cz in gamma band). Conclusions Our study suggests that alpha band activity may be the main neural oscillation of SA, which suggests that the neural network within the anterior frontal area may be important in the generation of SA.},
  langid = {english},
  keywords = {Cognitive science,Electroencephalography,Fingers,Functional magnetic resonance imaging,Hands,Neural networks,Sensory perception,Vision},
  file = {C:\Users\Joe\Zotero\storage\4BUQL634\Kang et al. - 2015 - Brain Networks Responsible for Sense of Agency An.pdf}
}

