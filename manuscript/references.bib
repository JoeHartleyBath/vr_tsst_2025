  title = {Neural Correlates of Sense of Agency in Motor Control: {{A}} Neuroimaging Meta-Analysis},
  shorttitle = {Neural Correlates of Sense of Agency in Motor Control},
  author = {Zito, Giuseppe A. and Wiest, Roland and Aybek, Selma},
