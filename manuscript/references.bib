@article{holmEstimatingBrainLoad2009,
  title = {Estimating {{Brain Load}} from the {{EEG}}},
  author = {Holm, Anu and Lukander, Kristian and Korpela, Jussi and Sallinen, Mikael and M{\"u}ller, Kiti M. I.},
  year = 2009,
  journal = {The Scientific World Journal},
