  title = {Physiological Stress Reactivity and Recovery: {{Some}} Laboratory Results Transfer to Daily Life},
  shorttitle = {Physiological Stress Reactivity and Recovery},
  author = {Bamert, Melanie and Inauen, Jennifer},
  year = 2022,
