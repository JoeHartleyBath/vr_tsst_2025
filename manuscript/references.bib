@article{knowlesSpecificityTraitAnxiety2020,
  title = {Specificity of {{Trait Anxiety}} in {{Anxiety}} and {{Depression}}: {{Meta-Analysis}} of the {{State-Trait Anxiety Inventory}}},
  shorttitle = {Specificity of {{Trait Anxiety}} in {{Anxiety}} and {{Depression}}},
  author = {Knowles, Kelly A. and Olatunji, Bunmi O.},
