  author = {Dai, Zhongxiang and {de Souza}, Joshua and Lim, Julian and Ho, Paul M. and Chen, Yu and Li, Junhua and Thakor, Nitish and Bezerianos, Anastasios and Sun, Yu},
  year = 2017,
