@article{gentileNatureVirtualReality2023,
  title = {Nature through Virtual Reality as a Stress-Reduction Tool: {{A}} Systematic Review},
  shorttitle = {Nature through Virtual Reality as a Stress-Reduction Tool},
  author = {Gentile, Ambra and Ficarra, Salvatore and Thomas, Ewan and Bianco, Antonino and Nordstrom, Anna},
  year = 2023,
